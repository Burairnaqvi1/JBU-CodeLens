<Window x:Class="CodeLensAI.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeLens AI"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="680"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Flat themed button: keeps each button's own Background and adds hover/pressed
             feedback via a translucent overlay so it works on any base color in both themes. -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Border x:Name="Overlay"
                                    Background="{DynamicResource HoverOverlayBrush}"
                                    CornerRadius="6"
                                    Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 36px flat toolbar icon button (Segoe MDL2 glyph content). -->
        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- 36px flat toolbar text button (export formats). -->
        <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Themed text input with accent border when focused. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim themed scrollbars. -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tree items: themed hover + selection, MDL2 chevron, 150ms ease-in-out expand
             animation (LayoutTransform.ScaleY affects layout, so this reads as a height
             animation without hardcoding pixel heights). -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ActualWidth, ElementName=Expander}"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Width="16" Height="16"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <TextBlock x:Name="Chevron"
                                                                           Text="&#xE70D;"
                                                                           FontFamily="{DynamicResource IconFont}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="-90" CenterX="5" CenterY="5"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0">
                                <ItemsPresenter.LayoutTransform>
                                    <ScaleTransform ScaleY="1"/>
                                </ItemsPresenter.LayoutTransform>
                            </ItemsPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemsHost"
                                                             Storyboard.TargetProperty="LayoutTransform.ScaleY"
                                                             From="0" To="1" Duration="0:0:0.150">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <!-- Selection uses a theme-tinted highlight with TextPrimary text
                                 (per palette spec); badges keep their contrast on the tint. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER / TOOLBAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="8"
                            Margin="0,0,12,0">
                        <TextBlock Text="CL"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource SurfaceBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CodeLens AI"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Explore, document, and explain your codebase"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Light/Dark toggle -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LightThemeButton"
                                    Content="Light"
                                    Click="LightThemeButton_Click"
                                    Padding="12,5"
                                    ToolTip="Switch to the light theme"
                                    Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button x:Name="DarkThemeButton"
                                    Content="Dark"
                                    Click="DarkThemeButton_Click"
                                    Padding="12,5"
                                    ToolTip="Switch to the dark theme"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource SurfaceBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BrowseButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="BrowseButton_Click"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource SurfaceBrush}"
                            ToolTip="Open a project folder"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Open" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ScanButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE72C;"
                            Click="ScanButton_Click"
                            IsEnabled="False"
                            ToolTip="Rescan the current project"
                            Margin="0,0,10,0"/>

                    <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="0,0,10,0"/>

                    <Button x:Name="ExportWordButton"
                            Style="{StaticResource ToolbarTextButton}"
                            Content="Word"
                            Click="ExportWordButton_Click"
                            IsEnabled="False"
                            Margin="0,0,4,0"
                            ToolTip="Export documentation to Word (.docx)"/>
                    <Button x:Name="ExportMarkdownButton"
                            Style="{StaticResource ToolbarTextButton}"
                            Content="MD"
                            Click="ExportMarkdownButton_Click"
                            IsEnabled="False"
                            Margin="0,0,4,0"
                            ToolTip="Export project analysis to Markdown (.md)"/>
                    <Button x:Name="ExportJsonButton"
                            Style="{StaticResource ToolbarTextButton}"
                            Content="JSON"
                            Click="ExportJsonButton_Click"
                            IsEnabled="False"
                            ToolTip="Export project analysis to JSON (.json)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: fixed 280px, collapsible (animated in code-behind) -->
            <Border Grid.Column="0"
                    x:Name="SidebarPanel"
                    Width="280"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12,12,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Project Explorer"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ProjectPathText"
                                       Text="No project loaded"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,8,8,8">
                        <TreeView x:Name="ProjectTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="13"
                                  SelectedItemChanged="ProjectTree_SelectedItemChanged">
                            <TreeView.Style>
                                <Style TargetType="TreeView">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeView">
                                                <ItemsPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Style>
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Sidebar collapse toggle -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Button x:Name="SidebarToggleButton"
                        Click="SidebarToggleButton_Click"
                        Width="18"
                        VerticalAlignment="Stretch"
                        Padding="0"
                        ToolTip="Collapse or expand the project explorer">
                    <TextBlock x:Name="SidebarToggleIcon"
                               Text="&#xE76B;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <!-- Placeholder -->
                    <Border x:Name="DetailPlaceholder"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="16"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                                <TextBlock Text="CL" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Select a file, class, or function"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag &amp; drop a folder anywhere"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable detail -->
                    <ScrollViewer x:Name="DetailScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,20,24,20">
                        <StackPanel x:Name="DetailContentHost"/>
                    </ScrollViewer>

                    <!-- Inline notification banner: slides in from the top, auto-dismisses. -->
                    <Border x:Name="NotificationBanner"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Margin="24,12,24,0"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            Panel.ZIndex="10">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NotificationTransform" Y="-40"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NotificationAccent" Width="4" CornerRadius="2"
                                    Background="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="NotificationText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button x:Name="NotificationActionButton"
                                    Click="NotificationAction_Click"
                                    Grid.Column="2"
                                    Visibility="Collapsed"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource SurfaceBrush}"/>
                            <Button Grid.Column="3"
                                    Content="&#xE711;"
                                    FontFamily="{DynamicResource IconFont}"
                                    FontSize="11"
                                    Padding="8,4"
                                    Margin="6,0,0,0"
                                    ToolTip="Dismiss"
                                    Click="NotificationClose_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText"
                           Text="AI model ready"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Progress bar appears during scans (determinate, per file) and exports
                     (indeterminate); updates are immediate (no animation). -->
                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Column="1"
                             Width="140" Height="6"
                             Visibility="Collapsed"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Background="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource PrimaryBrush}"
                             BorderThickness="0"/>
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"
                        FontSize="11"
                        Padding="10,2"
                        Margin="12,2,12,2"
                        ToolTip="Cancel the running scan or export"/>
                <TextBlock Grid.Column="3"
                           Text="Drag &amp; drop a folder anywhere"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
