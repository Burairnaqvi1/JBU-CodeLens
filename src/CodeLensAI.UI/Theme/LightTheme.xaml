<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. The ONLY place (with DarkTheme.xaml) where color values are defined. -->
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DCDCDC</Color>
    <Color x:Key="PrimaryColor">#1565C0</Color>
    <Color x:Key="PrimaryHoverColor">#1E88E5</Color>
    <Color x:Key="SecondaryColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#E65100</Color>
    <Color x:Key="ErrorColor">#C62828</Color>
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="TreeSelectionColor">#BBDEFB</Color>

    <!-- Derived chrome colors -->
    <Color x:Key="HeaderColor">#ECECEC</Color>
    <Color x:Key="StatusBarColor">#ECECEC</Color>
    <Color x:Key="SidebarColor">#EFEFEF</Color>
    <Color x:Key="HoverOverlayColor">#14000000</Color>
    <Color x:Key="PressedOverlayColor">#26000000</Color>
    <Color x:Key="ScrollThumbColor">#C4C4C4</Color>
    <Color x:Key="ScrollThumbHoverColor">#A8A8A8</Color>
    <Color x:Key="ShadowColor">#66000000</Color>
</ResourceDictionary>
