<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. The ONLY place (with LightTheme.xaml) where color values are defined. -->
    <Color x:Key="BackgroundColor">#1E1E2E</Color>
    <Color x:Key="SurfaceColor">#252535</Color>
    <Color x:Key="BorderColor">#3A3A4F</Color>
    <Color x:Key="PrimaryColor">#4FC3F7</Color>
    <Color x:Key="PrimaryHoverColor">#81D4FA</Color>
    <Color x:Key="SecondaryColor">#81C784</Color>
    <Color x:Key="WarningColor">#FFB74D</Color>
    <Color x:Key="ErrorColor">#EF5350</Color>
    <Color x:Key="TextPrimaryColor">#E8EAF6</Color>
    <Color x:Key="TextSecondaryColor">#9E9E9E</Color>
    <Color x:Key="TreeSelectionColor">#0D47A1</Color>

    <!-- Derived chrome colors -->
    <Color x:Key="HeaderColor">#181825</Color>
    <Color x:Key="StatusBarColor">#181825</Color>
    <Color x:Key="SidebarColor">#232334</Color>
    <Color x:Key="HoverOverlayColor">#1FFFFFFF</Color>
    <Color x:Key="PressedOverlayColor">#38FFFFFF</Color>
    <Color x:Key="ScrollThumbColor">#45455A</Color>
    <Color x:Key="ScrollThumbHoverColor">#5A5A72</Color>
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
