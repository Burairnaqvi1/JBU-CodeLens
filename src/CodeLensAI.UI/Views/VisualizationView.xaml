<UserControl x:Class="CodeLensAI.UI.Views.VisualizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: back + title + status + depth selector + zoom controls -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="VizBackButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="BackButton_Click"
                            ToolTip="Back to the dashboard"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE8A9;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="16"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Project Tree"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16,0,16,0"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Depth selector (segmented, mirrors the Light/Dark toggle pattern) -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DepthFilesButton"
                                    Content="Files"
                                    Click="DepthButton_Click"
                                    Padding="12,5"
                                    ToolTip="Show folders and files only"/>
                            <Button x:Name="DepthClassesButton"
                                    Content="Classes"
                                    Click="DepthButton_Click"
                                    Padding="12,5"
                                    ToolTip="Show down to classes"/>
                            <Button x:Name="DepthMethodsButton"
                                    Content="Methods"
                                    Click="DepthButton_Click"
                                    Padding="12,5"
                                    ToolTip="Show the full tree including methods"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ZoomOutButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE71F;"
                            Click="ZoomOutButton_Click"
                            ToolTip="Zoom out"
                            Margin="0,0,4,0"/>
                    <Button x:Name="ZoomInButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE8A3;"
                            Click="ZoomInButton_Click"
                            ToolTip="Zoom in"
                            Margin="0,0,4,0"/>
                    <Button x:Name="FitButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE9A6;"
                            Click="FitButton_Click"
                            ToolTip="Fit the whole tree in the view"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DIAGRAM -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="CanvasScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False"
                          PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                <Canvas x:Name="TreeCanvas"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="TreeCanvas_MouseLeftButtonDown"
                        MouseMove="TreeCanvas_MouseMove"
                        MouseLeftButtonUp="TreeCanvas_MouseLeftButtonUp">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>

            <!-- Interaction hint (never blocks the canvas) -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,12"
                    Padding="10,4,10,4"
                    CornerRadius="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Opacity="0.9"
                    IsHitTestVisible="False">
                <TextBlock Text="Scroll to zoom · drag to pan · click a node to open it"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
