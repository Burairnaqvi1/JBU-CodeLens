<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. The ONLY place (with LightTheme.xaml) where color values are defined.
         Deep indigo ground with an azure→violet accent pair; neutrals carry a blue bias so
         nothing reads as default gray. -->
    <Color x:Key="BackgroundColor">#0F1522</Color>
    <Color x:Key="SurfaceColor">#17202F</Color>
    <Color x:Key="BorderColor">#27334A</Color>
    <Color x:Key="PrimaryColor">#4AA3FF</Color>
    <Color x:Key="PrimaryHoverColor">#74BAFF</Color>

    <!-- Filled-accent pair, used only by AccentGradientBrush and always carrying white text.
         Deliberately deeper than PrimaryColor: PrimaryColor is bright because it is read as
         text ON the dark ground, whereas these are the ground themselves. At PrimaryColor's
         brightness, white on top reaches only 2.6:1 — below the 4.5:1 needed to be legible.
         These give 4.9:1 and 6.4:1, and read richer against the near-black background. -->
    <Color x:Key="AccentDeepColor">#2A72C4</Color>
    <Color x:Key="AccentAltColor">#6149C9</Color>
    <Color x:Key="SecondaryColor">#4FC97E</Color>
    <Color x:Key="WarningColor">#F5B45C</Color>
    <Color x:Key="ErrorColor">#F16A5E</Color>
    <Color x:Key="TextPrimaryColor">#EAF0F9</Color>
    <Color x:Key="TextSecondaryColor">#93A2B7</Color>
    <Color x:Key="TreeSelectionColor">#1E3A60</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- Derived chrome colors -->
    <Color x:Key="HeaderColor">#0A0F1A</Color>
    <Color x:Key="StatusBarColor">#0A0F1A</Color>
    <Color x:Key="SidebarColor">#121A28</Color>
    <Color x:Key="HoverOverlayColor">#1AFFFFFF</Color>
    <Color x:Key="PressedOverlayColor">#33FFFFFF</Color>
    <Color x:Key="ScrollThumbColor">#33415C</Color>
    <Color x:Key="ScrollThumbHoverColor">#475877</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="CloseHoverColor">#E5484D</Color>
</ResourceDictionary>
