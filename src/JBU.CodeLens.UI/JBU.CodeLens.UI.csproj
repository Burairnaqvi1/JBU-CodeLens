<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JBU.CodeLens.Core\JBU.CodeLens.Core.csproj" />
    <ProjectReference Include="..\JBU.CodeLens.Shared\JBU.CodeLens.Shared.csproj" />
  </ItemGroup>

  <!--
    The LLamaSharp CPU backend ships its native-library copy logic in a plain build/ props file,
    which only runs for the project that references it directly. The Core project reference does not
    propagate it, so without this the native llama/ggml DLLs never reach the WPF executable's output
    and inference fails at runtime with a DllNotFoundException. Referencing the backend here makes
    those props run during the UI build and copy the natives into this app's output.
  -->
  <ItemGroup>
    <PackageReference Include="libclang.runtime.win-x64" Version="21.1.8" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

  <!-- libclang ships under runtimes/win-x64/native; P/Invoke expects libclang.dll beside the executable. -->
  <Target Name="CopyLibClangToAppRoot" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_LibClangSource>$(OutputPath)runtimes\win-x64\native\libclang.dll</_LibClangSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_LibClangSource)" DestinationFiles="$(OutputPath)libclang.dll" SkipUnchangedFiles="true" Condition="Exists('$(_LibClangSource)')" />
  </Target>

  <!--
    LLamaSharp.Backend.Cpu carries native llama/ggml binaries for every platform it supports, and
    publishing keeps all of them even with a win-x64 RuntimeIdentifier. That is roughly 77 MB of
    Linux, macOS and ARM libraries this app can never load, in a folder that is already large
    because the language model ships inside it. Removed after publish so what gets handed to
    someone else is only what runs.
  -->
  <Target Name="TrimForeignRuntimes" AfterTargets="Publish">
    <ItemGroup>
      <_ForeignRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))"
                          Condition="Exists('$(PublishDir)runtimes')" />
      <!-- GetDirectories returns paths with no trailing separator, so %(Filename) is the RID. -->
      <_KeepRuntimeDir Include="@(_ForeignRuntimeDir)" Condition="'%(Filename)' == '$(RuntimeIdentifier)'" />
      <_DropRuntimeDir Include="@(_ForeignRuntimeDir)" Exclude="@(_KeepRuntimeDir)" />
    </ItemGroup>
    <RemoveDir Directories="@(_DropRuntimeDir)" Condition="'@(_DropRuntimeDir)' != ''" />
    <Message Importance="high" Text="Trimmed runtimes: removed @(_DropRuntimeDir->'%(Filename)', ', ')" Condition="'@(_DropRuntimeDir)' != ''" />
  </Target>

  <ItemGroup>
    <ApplicationDefinition Include="Theme\App.xaml" />
    <Page Remove="Theme\App.xaml" />
  </ItemGroup>

  <!--
    Brand assets live in the solution-level assets/ folder because the Word exporter in Core needs
    the logo too; linking one copy from both projects keeps them from drifting apart. Embedded as
    resources so they resolve from a pack URI rather than depending on files sitting beside the
    executable.

    logo-tile.png is what the window uses. The tile carries its own background, so the same asset
    reads correctly against both the near-black dark theme and the near-white light one; the
    transparent mark alone washed out on light backgrounds.
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\logo-tile.png" Link="Assets\logo-tile.png" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />

    <!-- Also embedded, not just set as ApplicationIcon: the window's Icon property resolves it
         through a pack URI, and without the resource the window fails to construct at startup. -->
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
</Project>
