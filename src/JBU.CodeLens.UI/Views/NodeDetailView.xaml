<UserControl x:Class="JBU.CodeLens.UI.Views.NodeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:JBU.CodeLens.UI.Helpers">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center">
                <Button x:Name="DetailBackButton"
                        Style="{StaticResource ToolbarIconButton}"
                        Click="BackButton_Click"
                        ToolTip="Back to the project tree"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="&#xE946;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="15"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="HeaderTitle"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="DetailScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.FollowSystemSetting="True"
                      Padding="24,20,24,20">
            <StackPanel x:Name="DetailHost"/>
        </ScrollViewer>
    </Grid>
</UserControl>
